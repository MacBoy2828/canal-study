{
  "expo": {
    "name": "Canal Study",
    "slug": "canal-study",
    "version": "2.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "canalstudy",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.canalstudy.app",
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A8C0D4",
        "foregroundImage": "./assets/images/brand-mark.png"
      },
      "package": "com.canalstudy.app",
      "versionCode": 5,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#D7E4EE"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#E36A2A",
          "defaultChannel": "study-reminders"
        }
      ]
    ],
    "extra": {
      "updates": {
        "githubOwner": "MacBoy2828",
        "githubRepo": "canal-study",
        "apkAssetName": "Canal-Study.apk"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
